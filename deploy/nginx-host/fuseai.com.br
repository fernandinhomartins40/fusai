# nginx do HOST (VPS 72.60.10.112) para fuseai.com.br, www.fuseai.com.br e api.fuseai.com.br.
# Instalado UMA vez pelo deploy/setup-host.sh (com aprovação). Depois, o certbot (--nginx)
# acrescenta os blocos HTTPS e o redirecionamento HTTP -> HTTPS, como nos outros sites.
# O compose da FuseAI escuta só em 127.0.0.1:3500; o fuseai-nginx roteia pelo Host.

# Sem www -> www (endereço canônico).
server {
  listen 80;
  listen [::]:80;
  server_name fuseai.com.br;
  return 301 https://www.fuseai.com.br$request_uri;
}

server {
  listen 80;
  listen [::]:80;
  server_name www.fuseai.com.br;

  client_max_body_size 2m;

  location / {
    proxy_pass http://127.0.0.1:3500;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 60s;
  }
}

server {
  listen 80;
  listen [::]:80;
  server_name api.fuseai.com.br;

  client_max_body_size 21m;

  location / {
    proxy_pass http://127.0.0.1:3500;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    # SSE (chat em streaming) e MCP.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }
}
