{
  "name": "@fuseai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fuseai/db": "workspace:*",
    "@fuseai/shared": "workspace:*",
    "better-auth": "1.7.7",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "^6.0.0",
    "ioredis": "5.11.1",
    "js-tiktoken": "1.0.21",
    "nodemailer": "^7.0.13",
    "pino": "^9.14.0",
    "secure-json-parse": "^4.1.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@fuseai/config": "workspace:*",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "openai": "^6.49.0",
    "pino-pretty": "13.2.0",
    "tsup": "^8.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
