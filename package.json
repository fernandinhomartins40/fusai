{
  "name": "fusai",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fusai/db generate",
    "db:migrate": "pnpm --filter @fusai/db migrate",
    "db:seed": "pnpm --filter @fusai/db seed",
    "db:studio": "pnpm --filter @fusai/db studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  }
}
