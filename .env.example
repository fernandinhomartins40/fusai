# Geral
NODE_ENV=development
APP_URL=http://localhost:3000            # prod: https://www.fusai.com.br
API_URL=http://localhost:4000            # prod: https://api.fusai.com.br
COOKIE_DOMAIN=localhost                  # prod: .fusai.com.br
INTERNAL_API_URL=                        # opcional: URL da API vista pelo servidor Next (ex.: http://api:4000 no Docker)

# Banco / Redis
DATABASE_URL=postgresql://fuseai:fuseai@localhost:5432/fuseai
TEST_DATABASE_URL=                       # opcional; padrão: DATABASE_URL com sufixo _test
REDIS_URL=redis://localhost:6379
TEST_REDIS_URL=                          # opcional; padrão: redis://localhost:6379/1 (testes)

# Auth
BETTER_AUTH_SECRET=change-me-32-bytes
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segurança
ENCRYPTION_KEY=                          # OBRIGATÓRIO. Gere: openssl rand -base64 32  (ou node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
KEY_PEPPER=change-me                     # hash das chaves de API; trocar invalida todas as chaves
SESSION_TOKEN_SECRET=change-me           # JWT dos session tokens de usuário final

# Asaas
ASAAS_ENV=sandbox                        # sandbox | production
ASAAS_API_KEY=                           # sandbox: $aact_hmlg_...  produção: $aact_prod_...
ASAAS_API_URL=                           # opcional: sobrescreve a URL (testes / Asaas falso)
ASAAS_WEBHOOK_TOKEN=change-me            # o mesmo token configurado no webhook do Asaas (header asaas-access-token)

# Email
EMAIL_FROM="fusai <nao-responda@fusai.com.br>"
RESEND_API_KEY=
SMTP_URL=smtp://localhost:1025           # Mailpit em dev

# Seed
SEED_ADMIN_EMAIL=admin@fusai.com.br
SEED_ADMIN_PASSWORD=change-me-now
