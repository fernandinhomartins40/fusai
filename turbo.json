{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "APP_URL",
    "API_URL",
    "INTERNAL_API_URL",
    "COOKIE_DOMAIN",
    "HOST",
    "PORT",
    "LOG_LEVEL",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "BETTER_AUTH_*",
    "GOOGLE_*",
    "ENCRYPTION_KEY",
    "KEY_PEPPER",
    "SESSION_TOKEN_SECRET",
    "ASAAS_*",
    "EMAIL_FROM",
    "RESEND_API_KEY",
    "SMTP_URL",
    "SEED_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}
